APP_NAME="SUMAS Hostel Management System"
APP_ENV=local
APP_KEY=base64:cXJpovcCHHm8DoAX6ROjHdJm4VTIagurwTrh6t3cQBQ=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite is used by default so the app runs with zero database setup.
# Just run: touch database/database.sqlite
DB_CONNECTION=sqlite
# If you prefer MySQL instead, comment the two lines above and uncomment below:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sumas_hostels
# DB_USERNAME=root
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_STORE=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hostels@sumas.edu.ng"
MAIL_FROM_NAME="${APP_NAME}"

SUMAS_ACADEMIC_SESSION="2026/2027"
